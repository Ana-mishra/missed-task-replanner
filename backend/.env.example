# Copy to .env and adjust. Never commit .env (it is git-ignored).
# Use only placeholder/example values here; put real credentials in .env
# locally or in the hosting platform's environment settings.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/planora
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
# Web Push (VAPID) keys for browser notifications. Generate once locally with
# `python scripts/generate_vapid_keys.py` (run from backend/) and store the
# output as Railway environment variables. Never commit real keys.
# VAPID_PRIVATE_KEY holds the full PEM block (newlines preserved);
# VAPID_PUBLIC_KEY is the public key string returned by the script.
# Leave empty until actual push delivery is enabled; the app starts and
# runs normally without them (push attempts fail safely).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@planora.local
